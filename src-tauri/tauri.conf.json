{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atogaki",
  "version": "0.1.0",
  "identifier": "com.chai-yinfeng.atogaki",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atogaki",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/whisper-cli"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "third-party/": "third-party/"
    }
  }
}
