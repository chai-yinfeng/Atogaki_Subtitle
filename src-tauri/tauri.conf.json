{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atogaki",
  "version": "0.1.3",
  "identifier": "com.chai-yinfeng.atogaki",
  "build": {
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Atogaki",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      },
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/whisper-cli"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "third-party/": "third-party/",
      "../src/infrastructure/online_worker/__init__.py": "online_worker/__init__.py",
      "../src/infrastructure/online_worker/__main__.py": "online_worker/__main__.py",
      "../src/infrastructure/online_worker/worker.py": "online_worker/worker.py",
      "../src/infrastructure/online_worker/pcm_input.py": "online_worker/pcm_input.py",
      "../src/infrastructure/online_worker/asr_models.py": "online_worker/asr_models.py",
      "../src/infrastructure/online_worker/mt.py": "online_worker/mt.py",
      "../src/infrastructure/online_worker/retranslation.py": "online_worker/retranslation.py",
      "../src/infrastructure/online_worker/stage_admission.py": "online_worker/stage_admission.py",
      "../src/infrastructure/online_worker/drain_budget.py": "online_worker/drain_budget.py"
    }
  }
}
