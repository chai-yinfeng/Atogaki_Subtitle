    { "dot": "cyan", "title": "文件任务与正式字幕", "items": [
      "Whisper 或本地 Qwen3-ASR 识别。Qwen 使用强制对齐。任务目录保存派生音频、运行产物和恢复检查点。",
      "完整原文进入工作区，翻译按任务配置执行。局部重识别先生成候选，经复核采用后才写入。学习收藏保留例句和来源时间。"
    ] },
    { "dot": "violet", "title": "在线会话", "items": [
      "模型就绪后启动系统声音采集，PCM 进入本地 Python Worker。在线识别和本地翻译的修订事件驱动主窗口与字幕浮窗。",
      "在线会话与正式任务资料分开。云端实时同传及自动建离线任务仍在研究或规划中。"
    ] },
    { "dot": "amber", "title": "播放与交付", "items": [
      "本机文件经受限回环服务播放。当前分支支持收听视频全屏双语轨。",
      "独立导出 SRT／ASS，可选 MKV 软字幕封装。烧录直接输出 MP4，或输出可供后期压制的 ProRes 中间文件。"
    ] },
    { "dot": "rose", "title": "云端与凭据边界", "items": [
      "云端翻译按配置发送文本和有限上下文。Gemini 局部重识别对指定音频范围单独授权。在线词典只在用户发起查询时发送选中文本。",
      "API Key 保存在系统凭据库。图中的云端箭头概括任务用例实际允许的出站请求。"
    ] }
